<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الأنوار مول | عروض الجمعة البيضاء - Alanwar Mall</title>
    
    <!-- SEO & Open Graph -->
    <meta name="description" content="عروض الجمعة البيضاء من الأنوار مول. خصومات كبرى على الأجهزة الكهربائية والمنزلية. منذ عام 1988.">
    <meta property="og:title" content="الأنوار مول - عروض الجمعة البيضاء">
    <meta property="og:description" content="خصومات تصل إلى 40% على أفضل الماركات. تواصل معنا عبر واتساب.">
    <meta property="og:image" content="https://via.placeholder.com/1200x630?text=Alanwar+Mall+White+Friday">
    <meta property="og:type" content="website">
    
    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@600;700;800&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Schema.org -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "الأنوار مول - Alanwar Mall",
      "foundingDate": "1988",
      "description": "أكثر من 35 سنة خبرة في مجال الأجهزة الكهربائية.",
      "telephone": "+201144410062"
    }
    </script>

    <style>
        /* ============================================================
           1. نظام الألوان والخطوط (Dark Glassmorphism Theme)
           ============================================================ */
        :root {
            /* الألوان الأساسية */
            --bg: #08142F;           /* كحلي داكن جداً للخلفية */
            --bg-2: #0D1E45;         /* كحلي أفتح للأقسام */
            --card-bg: rgba(255, 255, 255, 0.05); /* زجاجي شفاف */
            --card-border: rgba(255, 255, 255, 0.1);
            
            --primary: #FFFFFF;      /* أبيض للعناوين */
            --gold: #F5A524;         /* ذهبي للأسعار والتمييز */
            --gold-hover: #D98B1A;
            --teal: #5FA89A;         /* تركواز للتفاصيل */
            
            /* النصوص */
            --text: #E2E8F0;         /* رمادي فاتح جداً للنصوص */
            --text-light: #A0B2C6;   /* رمادي مزرق للنصوص الثانوية */
            --text-white: #FFFFFF;
            
            /* الحالات */
            --success: #10B981;
            --danger: #EF4444;
            
            /* المسافات (نظام 8px) */
            --sp-1: 8px;
            --sp-2: 16px;
            --sp-3: 24px;
            --sp-4: 32px;
            --sp-5: 48px;
            --sp-6: 64px;
            
            /* الحواف */
            --radius-sm: 8px;
            --radius-md: 16px;
            --radius-lg: 24px;
            
            /* الظلال */
            --shadow-sm: 0 4px 12px rgba(0,0,0,0.3);
            --shadow-lg: 0 10px 30px rgba(0,0,0,0.5);
            
            --transition: all 0.3s ease;
        }

        /* دعم تقليل الحركة */
        @media (prefers-reduced-motion: reduce) {
            * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
        }

        /* ============================================================
           2. إعدادات عامة
           ============================================================ */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Tajawal', sans-serif;
            background-color: var(--bg);
            color: var(--text);
            line-height: 1.6;
            overflow-x: hidden;
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(58, 141, 222, 0.08), transparent 25%),
                radial-gradient(circle at 85% 30%, rgba(245, 165, 36, 0.05), transparent 25%);
            background-attachment: fixed;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Cairo', sans-serif;
            color: var(--primary);
            font-weight: 700;
            line-height: 1.3;
        }

        a { text-decoration: none; color: inherit; }
        ul { list-style: none; }
        button, input, select, textarea { font-family: inherit; font-size: 16px; }
        
        /* الأيقونات */
        svg { width: 24px; height: 24px; stroke: currentColor; stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 var(--sp-2);
        }

        /* الأزرار العامة (أهداف لمس لا تقل عن 44px) */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: var(--sp-1);
            padding: 12px 24px;
            min-height: 48px;
            border-radius: var(--radius-sm);
            font-weight: 700;
            cursor: pointer;
            border: none;
            transition: var(--transition);
            text-align: center;
        }

        .btn-gold {
            background-color: var(--gold);
            color: var(--bg);
            box-shadow: 0 4px 15px rgba(245, 165, 36, 0.2);
        }
        .btn-gold:hover { background-color: var(--gold-hover); transform: translateY(-2px); }

        .btn-primary {
            background-color: var(--primary);
            color: var(--bg);
        }
        .btn-primary:hover { background-color: #E2E8F0; transform: translateY(-2px); }

        .btn-wa {
            background-color: #25D366;
            color: white;
        }
        .btn-wa:hover { background-color: #1eb955; }

        .btn-outline {
            background: transparent;
            border: 1px solid var(--text-light);
            color: var(--primary);
        }
        .btn-outline:hover { background: rgba(255,255,255,0.1); border-color: var(--primary); }

        /* ============================================================
           3. الهيدر (Header)
           ============================================================ */
        header {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(8, 20, 47, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--card-border);
            padding: var(--sp-1) 0;
        }

        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 64px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo img {
            height: 45px;
            width: auto;
            object-fit: contain;
        }

        .nav-links {
            display: none;
            gap: var(--sp-3);
        }

        .nav-links a {
            font-weight: 700;
            color: var(--text);
            transition: var(--transition);
            font-size: 15px;
        }
        .nav-links a:hover { color: var(--gold); }

        .header-actions { display: flex; align-items: center; gap: var(--sp-1); }

        .menu-toggle { display: block; background: none; border: none; cursor: pointer; color: var(--primary); }

        /* ============================================================
           4. قسم البطل (Hero) والعداد التنازلي
           ============================================================ */
        .hero {
            padding: var(--sp-5) 0;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .hero h1 { color: var(--primary); font-size: clamp(28px, 5vw, 42px); margin-bottom: var(--sp-2); }
        .hero h1 span { color: var(--gold); text-shadow: 0 0 20px rgba(245,165,36,0.4); }
        .hero p { font-size: clamp(16px, 2vw, 20px); color: var(--text-light); margin-bottom: var(--sp-4); max-width: 600px; margin-inline: auto; }

        .countdown-container {
            display: flex; justify-content: center; gap: var(--sp-2); margin-bottom: var(--sp-4); direction: ltr;
        }
        .countdown-box {
            background: var(--card-bg); border: 1px solid var(--card-border);
            border-radius: var(--radius-sm); padding: var(--sp-1); min-width: 70px;
            display: flex; flex-direction: column; align-items: center;
            backdrop-filter: blur(10px);
        }
        .countdown-box span { font-size: 28px; font-weight: 800; color: var(--gold); }
        .countdown-box label { font-size: 12px; color: var(--text-light); }

        .hero-btns { display: flex; justify-content: center; gap: var(--sp-2); flex-wrap: wrap; z-index: 2; position: relative; }

        /* ============================================================
           5. شريط عرض بيكو (Beko Banner)
           ============================================================ */
        .beko-banner {
            background: linear-gradient(135deg, rgba(245, 165, 36, 0.15), rgba(95, 168, 154, 0.15));
            border: 1px solid var(--gold);
            border-radius: var(--radius-md);
            padding: var(--sp-3);
            margin: var(--sp-4) auto;
            max-width: 800px;
            display: flex; align-items: center; gap: var(--sp-2); flex-wrap: wrap; justify-content: center; text-align: center;
            box-shadow: 0 0 30px rgba(245, 165, 36, 0.1);
        }
        .beko-banner svg { color: var(--gold); width: 40px; height: 40px; }
        .beko-banner p { font-size: 18px; font-weight: 700; color: var(--primary); margin: 0; }

        /* ============================================================
           6. قسم الثقة (Trust Section)
           ============================================================ */
        .trust-section {
            padding: var(--sp-5) 0;
            background: var(--bg-2);
            border-top: 1px solid var(--card-border);
            border-bottom: 1px solid var(--card-border);
        }

        .trust-grid {
            display: grid; grid-template-columns: 1fr; gap: var(--sp-4); text-align: center;
        }

        .trust-item h3 { font-size: 40px; color: var(--gold); margin-bottom: var(--sp-1); text-shadow: 0 0 20px rgba(245,165,36,0.3); }
        .trust-item p { font-size: 16px; font-weight: 500; color: var(--text-light); }
        .trust-item h4 { font-size: 22px; color: var(--primary); margin-bottom: var(--sp-1); }

        /* ============================================================
           7. شريط الأدوات (الفلاتر والبحث)
           ============================================================ */
        .toolbar {
            background: var(--card-bg); border-radius: var(--radius-md); padding: var(--sp-2);
            box-shadow: var(--shadow-sm); margin-bottom: var(--sp-3); border: 1px solid var(--card-border);
            backdrop-filter: blur(10px);
        }

        .toolbar-top {
            display: flex; flex-direction: column; gap: var(--sp-2); margin-bottom: var(--sp-2);
        }

        .search-box { position: relative; width: 100%; }
        .search-box input {
            width: 100%; padding: 12px 16px 12px 44px; border-radius: var(--radius-sm);
            border: 1px solid var(--card-border); background: rgba(0,0,0,0.2);
            color: var(--primary); font-size: 15px; outline: none; transition: var(--transition);
        }
        .search-box input:focus { border-color: var(--gold); }
        .search-box svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-light); }

        .sort-box select {
            width: 100%; padding: 12px; border-radius: var(--radius-sm);
            border: 1px solid var(--card-border); background: rgba(0,0,0,0.2);
            color: var(--primary); font-size: 15px; cursor: pointer; outline: none;
        }
        .sort-box select option { background: var(--bg-2); color: white; }

        .categories-scroll {
            display: flex; gap: var(--sp-1); overflow-x: auto; padding-bottom: var(--sp-1);
            scrollbar-width: none;
        }
        .categories-scroll::-webkit-scrollbar { display: none; }

        .cat-pill {
            background: rgba(255,255,255,0.05); border: 1px solid var(--card-border); color: var(--text); 
            padding: 8px 16px; border-radius: 50px; font-weight: 600; font-size: 14px;
            cursor: pointer; white-space: nowrap; transition: var(--transition);
        }
        .cat-pill:hover { background: rgba(255,255,255,0.1); }
        .cat-pill.active { background: var(--gold); color: var(--bg); border-color: var(--gold); }

        /* ============================================================
           8. شبكة المنتجات (Product Grid)
           ============================================================ */
        .products-grid {
            display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-2); margin-bottom: var(--sp-4);
        }

        .product-card {
            background: var(--card-bg); border-radius: var(--radius-md); overflow: hidden;
            box-shadow: var(--shadow-sm); border: 1px solid var(--card-border);
            display: flex; flex-direction: column; transition: var(--transition); position: relative;
            backdrop-filter: blur(10px);
        }
        .product-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: rgba(255,255,255,0.25); }

        .product-img {
            width: 100%; aspect-ratio: 1; background: rgba(0,0,0,0.2); position: relative;
            display: flex; align-items: center; justify-content: center; padding: var(--sp-2);
        }
        .product-img img { width: 100%; height: 100%; object-fit: contain; }
        .product-img .placeholder-icon { width: 64px; height: 64px; color: var(--text-light); opacity: 0.5; }

        .badges-container { position: absolute; top: 10px; right: 10px; display: flex; flex-direction: column; gap: 4px; z-index: 2; }
        .badge {
            padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: 700;
            color: white; text-align: center;
        }
        .badge-discount { background: var(--danger); }
        .badge-bestseller { background: var(--gold); color: var(--bg); }
        .badge-limited { background: var(--primary); color: var(--bg); }

        .product-info { padding: var(--sp-2); display: flex; flex-direction: column; flex: 1; }
        
        .product-title {
            font-size: 14px; font-weight: 700; color: var(--primary); margin-bottom: var(--sp-1);
            display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
            line-height: 1.4; min-height: 40px;
        }

        .product-price { margin-top: auto; margin-bottom: var(--sp-2); }
        .price-current { font-size: 18px; font-weight: 800; color: var(--gold); }
        .price-old { font-size: 13px; color: var(--text-light); text-decoration: line-through; margin-right: var(--sp-1); }
        
        .product-card .btn { width: 100%; font-size: 14px; padding: 8px; min-height: 40px; }

        /* Load More & Empty State */
        .load-more-container { text-align: center; margin-bottom: var(--sp-5); }
        .empty-state { text-align: center; padding: var(--sp-5); background: var(--card-bg); border-radius: var(--radius-md); grid-column: 1 / -1; border: 1px solid var(--card-border); }
        .empty-state h3 { margin-bottom: var(--sp-1); }

        /* ============================================================
           9. نهاية الموقع (Copyright)
           ============================================================ */
        .copyright-text {
            text-align: center;
            padding: var(--sp-4) 0 var(--sp-3);
            color: var(--text-light);
            font-size: 14px;
            font-weight: 500;
            border-top: 1px solid var(--card-border);
            margin-top: var(--sp-4);
        }

        /* ============================================================
           10. العناصر العائمة (Floating)
           ============================================================ */
        .float-wa {
            position: fixed; bottom: 20px; left: 20px; width: 56px; height: 56px;
            background: #25D366; border-radius: 50%; display: flex; align-items: center; justify-content: center;
            color: white; box-shadow: var(--shadow-lg); z-index: 90; transition: var(--transition);
        }
        .float-wa:hover { transform: scale(1.1); }
        .float-wa svg { width: 30px; height: 30px; fill: currentColor; stroke: none; }

        .back-to-top {
            position: fixed; bottom: 20px; right: 20px; width: 44px; height: 44px;
            background: var(--gold); border-radius: 50%; display: flex; align-items: center; justify-content: center;
            color: var(--bg); box-shadow: var(--shadow-md); z-index: 90; cursor: pointer; border: none;
            opacity: 0; visibility: hidden; transition: var(--transition);
        }
        .back-to-top.show { opacity: 1; visibility: visible; }

        /* ============================================================
           11. لوحة التحكم المخفية (Admin Dashboard)
           ============================================================ */
        .admin-overlay {
            position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8);
            backdrop-filter: blur(5px); z-index: 1000; display: none; align-items: center; justify-content: center; padding: var(--sp-2);
        }
        .admin-overlay.active { display: flex; }

        .admin-panel {
            background: var(--bg-2); border-radius: var(--radius-md); width: 100%; max-width: 900px;
            max-height: 90vh; display: flex; flex-direction: column; overflow: hidden; border: 1px solid var(--card-border);
        }

        .admin-header {
            padding: var(--sp-2); border-bottom: 1px solid var(--card-border); display: flex; justify-content: space-between; align-items: center;
            background: rgba(0,0,0,0.3);
        }
        .admin-header h2 { color: var(--primary); font-size: 20px; }
        .close-admin { background: none; border: none; color: var(--text-light); cursor: pointer; }
        .close-admin:hover { color: var(--danger); }

        .admin-tabs {
            display: flex; border-bottom: 1px solid var(--card-border); background: rgba(0,0,0,0.1);
        }
        .admin-tab {
            padding: var(--sp-2); background: none; border: none; cursor: pointer; flex: 1;
            font-weight: 700; color: var(--text-light); border-bottom: 3px solid transparent; transition: var(--transition);
        }
        .admin-tab.active { color: var(--gold); border-bottom-color: var(--gold); background: rgba(255,255,255,0.02); }

        .admin-body { padding: var(--sp-3); overflow-y: auto; flex: 1; }
        .admin-section { display: none; }
        .admin-section.active { display: block; }

        /* Forms */
        .form-group { margin-bottom: var(--sp-2); }
        .form-group label { display: block; font-weight: 700; margin-bottom: 4px; font-size: 14px; color: var(--primary); }
        .form-control {
            width: 100%; padding: 10px 12px; border: 1px solid var(--card-border); background: rgba(0,0,0,0.2);
            color: var(--primary); border-radius: var(--radius-sm); outline: none;
        }
        .form-control:focus { border-color: var(--gold); }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-2); }
        .checkbox-group { display: flex; align-items: center; gap: 8px; cursor: pointer; color: var(--text); }
        
        .img-preview {
            width: 100px; height: 100px; border: 1px dashed var(--card-border); border-radius: var(--radius-sm);
            display: flex; align-items: center; justify-content: center; margin-top: 8px; overflow: hidden; background: rgba(0,0,0,0.2);
        }
        .img-preview img { width: 100%; height: 100%; object-fit: contain; }

        /* Admin Lists */
        .admin-list-item {
            display: flex; justify-content: space-between; align-items: center; padding: var(--sp-2);
            border: 1px solid var(--card-border); border-radius: var(--radius-sm); margin-bottom: var(--sp-1);
            background: rgba(255,255,255,0.02);
        }
        .admin-list-item.hidden { opacity: 0.5; background: rgba(0,0,0,0.2); }
        .admin-item-info h4 { font-size: 15px; margin-bottom: 2px; color: var(--primary); }
        .admin-item-info span { font-size: 13px; color: var(--gold); font-weight: 700; }
        .admin-actions { display: flex; gap: 8px; }

        /* Responsive */
        @media (min-width: 640px) {
            .header-content { height: 72px; }
            .products-grid { grid-template-columns: repeat(3, 1fr); }
            .toolbar-top { flex-direction: row; justify-content: space-between; align-items: center; }
            .search-box { width: 300px; }
            .sort-box select { width: auto; }
        }

        @media (min-width: 900px) {
            .nav-links { display: flex; }
            .menu-toggle { display: none; }
            .products-grid { grid-template-columns: repeat(4, 1fr); }
            .trust-grid { grid-template-columns: 1fr 1fr; align-items: center; }
            .hero { padding: var(--sp-6) 0; }
        }
    </style>
</head>
<body>

    <!-- ============================================================
         الهيدر (Header)
         ============================================================ -->
    <header>
        <div class="container header-content">
            <a href="#" class="logo" aria-label="الأنوار مول">
                <img id="header-logo" src="" alt="Alanwar Mall Logo" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 100 100\'><text x=\'50\' y=\'70\' font-size=\'50\' text-anchor=\'middle\' fill=\'%23F5A524\'>⚡</text></svg>'">
                <div>
                    <h2 style="font-size: 18px; margin-bottom: -4px; color: var(--primary);" id="header-title">الأنوار مول</h2>
                    <span style="font-size: 11px; color: var(--gold); font-weight: 700;">Alanwar Mall</span>
                </div>
            </a>
            
            <nav class="nav-links" aria-label="القائمة الرئيسية">
                <a href="#products">المنتجات</a>
            </nav>

            <div class="header-actions">
                <button class="btn btn-wa" onclick="openWA()" aria-label="تواصل عبر واتساب">
                    <svg viewBox="0 0 24 24" style="width:18px;height:18px;fill:currentColor;stroke:none;"><path d="M17.5 14.4c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.2-.7.2-.2.3-.8.9-1 1.1-.2.2-.4.2-.7.1-1.6-.8-2.7-1.5-3.7-3.3-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.6-.1-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.4-1.2 1.2-1.2 2.9 0 1.7 1.2 3.3 1.4 3.5.2.2 2.4 3.7 5.9 5.1 2.2.9 3.1.9 4.2.8.7-.1 2.1-.9 2.4-1.7.3-.8.3-1.5.2-1.7-.1-.1-.3-.2-.5-.3z"/><path d="M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.4 1.3 4.9L2 22l5.2-1.3c1.4.8 3.1 1.3 4.8 1.3 5.5 0 10-4.5 10-10S17.5 2 12 2z"/></svg>
                    <span>واتساب</span>
                </button>
                <button class="menu-toggle" aria-label="القائمة">
                    <svg viewBox="0 0 24 24"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                </button>
            </div>
        </div>
    </header>

    <main>
        <!-- ============================================================
             البطل (Hero) والعداد
             ============================================================ -->
        <section class="hero">
