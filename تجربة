                { id: "67", name: "عجان حلويات رافال 5 لتر", category: "أجهزة مطبخ", price: 4800, oldPrice: 6000, image: "", hidden: false, bestseller: false, limited: false },
                { id: "68", name: "هاند بلندر بوش 800 وات", category: "أجهزة مطبخ", price: 3699, oldPrice: 5000, image: "", hidden: false, bestseller: false, limited: false },
                { id: "69", name: "مفرمة لحم بوش ألماني 1600 وات", category: "أجهزة مطبخ", price: 4999, oldPrice: 8000, image: "", hidden: false, bestseller: false, limited: false },
                { id: "70", name: "مكنسة كهربائية فريش 1600 وات", category: "أجهزة مطبخ", price: 2999, oldPrice: 4000, image: "", hidden: false, bestseller: false, limited: false },
                { id: "71", name: "خلاط مولينكس الفرنساوي 700 وات", category: "أجهزة مطبخ", price: 2999, oldPrice: 4000, image: "", hidden: false, bestseller: false, limited: false },
                { id: "72", name: "هاند بلندر مينتا 1000 وات مجموعة", category: "أجهزة مطبخ", price: 1999, oldPrice: 2900, image: "", hidden: false, bestseller: false, limited: false },
                { id: "73", name: "كاتل زجاج رافال بيكرس", category: "أجهزة مطبخ", price: 599, oldPrice: 1000, image: "", hidden: false, bestseller: false, limited: false },
                { id: "74", name: "عجان حلويات رافال 7 لتر", category: "أجهزة مطبخ", price: 5999, oldPrice: 7500, image: "", hidden: false, bestseller: false, limited: false }
            ]
        };

        // ==========================================
        // 2. إدارة الحالة (State)
        // ==========================================
        let appData = JSON.parse(localStorage.getItem('alanwar_v3')) || DEFAULT_CONFIG;
        let currentCategory = "الكل";
        let searchQuery = "";
        let sortBy = "default";
        let currentPage = 1;
        const itemsPerPage = 12;
        let currentFiltered = [];

        // ==========================================
        // 3. التهيئة الأولية (Init)
        // ==========================================
        document.addEventListener('DOMContentLoaded', () => {
            setupUI();
            renderApp();
            startCountdown();
            checkHash();
            
            // Back to top scroll listener
            window.addEventListener('scroll', () => {
                const btn = document.getElementById('back-to-top');
                if (window.scrollY > 300) btn.classList.add('show');
                else btn.classList.remove('show');
            });

            // Hash change listener for admin
            window.addEventListener('hashchange', checkHash);
        });

        function setupUI() {
            // Logo
            const logoImg = document.getElementById('header-logo');
            if (appData.settings.logoUrl) {
                logoImg.src = appData.settings.logoUrl;
            }

            // Max Discount for Hero
            let maxDiscount = 0;
            appData.products.forEach(p => {
                if (!p.hidden && p.oldPrice && p.oldPrice > p.price) {
                    const d = Math.round(((p.oldPrice - p.price) / p.oldPrice) * 100);
                    if (d > maxDiscount) maxDiscount = d;
                }
            });
            document.getElementById('hero-discount').textContent = maxDiscount + '%';

            // Category Pills
            const catContainer = document.getElementById('categories-container');
            catContainer.innerHTML = appData.categories.map(cat => `
                <button class="cat-pill ${cat === currentCategory ? 'active' : ''}" onclick="setCategory('${cat}')">${cat}</button>
            `).join('');
        }

        function renderApp() {
            setupUI();
            applyFiltersAndSort();
            renderProducts();
        }

        // ==========================================
        // 4. الفلترة والفرز (Filter & Sort)
        // ==========================================
        function setCategory(cat) {
            currentCategory = cat;
            currentPage = 1;
            setupUI();
            applyFiltersAndSort();
            renderProducts();
        }

        function handleSearch() {
            searchQuery = document.getElementById('search-input').value.trim().toLowerCase();
            currentPage = 1;
            applyFiltersAndSort();
            renderProducts();
        }

        function handleSort() {
            sortBy = document.getElementById('sort-select').value;
            currentPage = 1;
            applyFiltersAndSort();
            renderProducts();
        }

        function applyFiltersAndSort() {
            let filtered = appData.products.filter(p => !p.hidden);

            if (currentCategory !== "الكل") {
                filtered = filtered.filter(p => p.category === currentCategory);
            }

            if (searchQuery) {
                filtered = filtered.filter(p => p.name.toLowerCase().includes(searchQuery) || p.category.toLowerCase().includes(searchQuery));
            }

            // Sorting
            if (sortBy === "price-asc") {
                filtered.sort((a, b) => a.price - b.price);
            } else if (sortBy === "price-desc") {
                filtered.sort((a, b) => b.price - a.price);
            } else if (sortBy === "discount-desc") {
                filtered.sort((a, b) => {
                    const dA = a.oldPrice ? (a.oldPrice - a.price) / a.oldPrice : 0;
                    const dB = b.oldPrice ? (b.oldPrice - b.price) / b.oldPrice : 0;
                    return dB - dA;
                });
            }

            currentFiltered = filtered;
        }

        // ==========================================
        // 5. عرض المنتجات (Render Products)
        // ==========================================
        function renderProducts() {
            const grid = document.getElementById('products-grid');
            const loadMoreBtn = document.getElementById('load-more-container');
            
            grid.innerHTML = ''; // Clear

            if (currentFiltered.length === 0) {
                grid.innerHTML = `<div class="empty-state"><h3>لا توجد نتائج مطابقة</h3><p>حاول تغيير كلمات البحث أو الفلاتر.</p></div>`;
                loadMoreBtn.style.display = 'none';
                return;
            }

            const itemsToShow = currentFiltered.slice(0, currentPage * itemsPerPage);
            
            grid.innerHTML = itemsToShow.map(p => {
                const discount = p.oldPrice && p.oldPrice > p.price ? Math.round(((p.oldPrice - p.price) / p.oldPrice) * 100) : 0;
                
                const imgHTML = p.image 
                    ? `<img src="${p.image}" alt="${p.name}" loading="lazy">` 
                    : `<svg class="placeholder-icon" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`;

                let badges = '';
                if (discount > 0) badges += `<span class="badge badge-discount">خصم ${discount}%</span>`;
                if (p.bestseller) badges += `<span class="badge badge-bestseller">الأكثر طلباً</span>`;
                if (p.limited) badges += `<span class="badge badge-limited">كمية محدودة</span>`;

                return `
                    <article class="product-card">
                        <div class="product-img">
                            ${imgHTML}
                            <div class="badges-container">${badges}</div>
                        </div>
                        <div class="product-info">
                            <h3 class="product-title">${p.name}</h3>
                            <div class="product-price">
                                <span class="price-current">${p.price.toLocaleString('en-US')} ج.م</span>
                                ${p.oldPrice ? `<span class="price-old">${p.oldPrice.toLocaleString('en-US')} ج.م</span>` : ''}
                            </div>
                            <button class="btn btn-wa" onclick="askProduct('${p.name.replace(/'/g, "\\'")}', ${p.price})">
                                <svg viewBox="0 0 24 24" style="fill:currentColor; stroke:none; width:16px; height:16px;"><path d="M17.5 14.4c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.2-.7.2-.2.3-.8.9-1 1.1-.2.2-.4.2-.7.1-1.6-.8-2.7-1.5-3.7-3.3-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.6-.1-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.4-1.2 1.2-1.2 2.9 0 1.7 1.2 3.3 1.4 3.5.2.2 2.4 3.7 5.9 5.1 2.2.9 3.1.9 4.2.8.7-.1 2.1-.9 2.4-1.7.3-.8.3-1.5.2-1.7-.1-.1-.3-.2-.5-.3z"/></svg>
                                اطلب عبر واتساب
                            </button>
                        </div>
                    </article>
                `;
            }).join('');

            if (itemsToShow.length < currentFiltered.length) {
                loadMoreBtn.style.display = 'block';
            } else {
                loadMoreBtn.style.display = 'none';
            }
        }

        function loadMore() {
            currentPage++;
            renderProducts();
        }

        // ==========================================
        // 6. الواتساب والعداد التنازلي
        // ==========================================
        function openWA() {
            const msg = "السلام عليكم، أرغب في الاستفسار عن عروض الأنوار مول.";
            window.open(`https://wa.me/${appData.settings.whatsapp}?text=${encodeURIComponent(msg)}`, '_blank');
        }

        function askProduct(name, price) {
            const msg = `السلام عليكم، أرغب بالاستفسار عن: ${name} - بسعر ${price} ج.م. هل متوفر؟`;
            window.open(`https://wa.me/${appData.settings.whatsapp}?text=${encodeURIComponent(msg)}`, '_blank');
        }

        function startCountdown() {
            const endDate = new Date(appData.settings.endDate).getTime();
            const container = document.getElementById('countdown');

            const timer = setInterval(() => {
                const now = new Date().getTime();
                const distance = endDate - now;

                if (distance < 0) {
                    clearInterval(timer);
                    container.innerHTML = "<p style='color:var(--gold); font-weight:bold;'>انتهى العرض!</p>";
                    return;
                }

                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                container.innerHTML = `
                    <div class="countdown-box"><span>${days}</span><label>يوم</label></div>
                    <div class="countdown-box"><span>${hours}</span><label>ساعة</label></div>
                    <div class="countdown-box"><span>${minutes}</span><label>دقيقة</label></div>
                    <div class="countdown-box"><span>${seconds}</span><label>ثانية</label></div>
                `;
            }, 1000);
        }

        // ==========================================
        // 7. لوحة التحكم (Admin Logic)
        // ==========================================
        function checkHash() {
            if (window.location.hash === '#admin') {
                const pwd = prompt("أدخل كلمة المرور:");
                if (pwd === appData.settings.password) {
                    document.getElementById('admin-panel').classList.add('active');
                    document.body.style.overflow = 'hidden';
                    loadAdminData();
                } else if (pwd !== null) {
                    alert("كلمة المرور غير صحيحة");
                    window.location.hash = '';
                }
            }
        }

        function closeAdmin() {
            document.getElementById('admin-panel').classList.remove('active');
            document.body.style.overflow = '';
            window.location.hash = '';
            renderApp(); // Refresh public site
        }

        function switchTab(tabId, event) {
            document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.admin-section').forEach(s => s.classList.remove('active'));
            
            event.target.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        }

        function loadAdminData() {
            // Settings
            document.getElementById('set-wa').value = appData.settings.whatsapp;
            document.getElementById('set-logo').value = appData.settings.logoUrl;
            document.getElementById('set-date').value = appData.settings.endDate;

            // Products List
            const list = document.getElementById('admin-products-list');
            list.innerHTML = appData.products.map(p => `
                <div class="admin-list-item ${p.hidden ? 'hidden' : ''}">
                    <div class="admin-item-info">
                        <h4>${p.name}</h4>
                        <span>${p.price.toLocaleString()} ج.م - ${p.category}</span>
                    </div>
                    <div class="admin-actions">
                        <button class="btn btn-outline btn-sm" onclick="editProduct('${p.id}')">تعديل</button>
                        <button class="btn btn-outline btn-sm" style="color:var(--danger); border-color:var(--danger)" onclick="deleteProduct('${p.id}')">حذف</button>
                    </div>
                </div>
            `).join('');
        }

        function saveSettings() {
            appData.settings.whatsapp = document.getElementById('set-wa').value;
            appData.settings.logoUrl = document.getElementById('set-logo').value;
            appData.settings.endDate = document.getElementById('set-date').value;
            saveToStorage();
            alert("تم حفظ الإعدادات!");
            loadAdminData();
        }

        function showProductForm() {
            document.getElementById('prod-id').value = '';
            document.getElementById('prod-name').value = '';
            document.getElementById('prod-category').value = 'ثلاجات';
            document.getElementById('prod-price').value = '';
            document.getElementById('prod-oldprice').value = '';
            document.getElementById('prod-image').value = '';
            document.getElementById('prod-hidden').checked = false;
            document.getElementById('prod-bestseller').checked = false;
            document.getElementById('prod-limited').checked = false;
            document.getElementById('img-preview').innerHTML = '<span style="font-size: 12px; color: var(--text-light);">لا توجد صورة</span>';
            document.getElementById('product-form-container').style.display = 'block';
        }

        function editProduct(id) {
            const p = appData.products.find(x => x.id === id);
            if (!p) return;

            document.getElementById('prod-id').value = p.id;
            document.getElementById('prod-name').value = p.name;
            document.getElementById('prod-category').value = p.category;
            document.getElementById('prod-price').value = p.price;
            document.getElementById('prod-oldprice').value = p.oldPrice || '';
            document.getElementById('prod-image').value = p.image || '';
            document.getElementById('prod-hidden').checked = p.hidden || false;
            document.getElementById('prod-bestseller').checked = p.bestseller || false;
            document.getElementById('prod-limited').checked = p.limited || false;
            
            updateImgPreview();
            document.getElementById('product-form-container').style.display = 'block';
        }

        function updateImgPreview() {
            const url = document.getElementById('prod-image').value;
            const preview = document.getElementById('img-preview');
            if (url) {
                preview.innerHTML = `<img src="${url}" onerror="this.parentElement.innerHTML='<span style=\\'font-size:12px;color:red;\\'>رابط غير صالح</span>'">`;
            } else {
                preview.innerHTML = '<span style="font-size: 12px; color: var(--text-light);">لا توجد صورة</span>';
            }
        }

        function saveProduct() {
            const id = document.getElementById('prod-id').value;
            const name = document.getElementById('prod-name').value.trim();
            const category = document.getElementById('prod-category').value;
            const price = Number(document.getElementById('prod-price').value);
            const oldPrice = Number(document.getElementById('prod-oldprice').value) || 0;
            const image = document.getElementById('prod-image').value.trim();
            const hidden = document.getElementById('prod-hidden').checked;
            const bestseller = document.getElementById('prod-bestseller').checked;
            const limited = document.getElementById('prod-limited').checked;

            if (!name || !price) {
                alert("يرجى إدخال اسم المنتج والسعر.");
                return;
            }

            const prodData = { name, category, price, oldPrice, image, hidden, bestseller, limited };

            if (id) {
                const p = appData.products.find(x => x.id === id);
                Object.assign(p, prodData);
            } else {
                appData.products.push({ id: Date.now().toString(), ...prodData });
            }

            saveToStorage();
            loadAdminData();
            document.getElementById('product-form-container').style.display = 'none';
            alert("تم الحفظ بنجاح!");
        }

        function deleteProduct(id) {
            if (confirm("هل أنت متأكد من حذف هذا المنتج نهائياً؟")) {
                appData.products = appData.products.filter(x => x.id !== id);
                saveToStorage();
                loadAdminData();
            }
        }

        function saveToStorage() {
            localStorage.setItem('alanwar_v3', JSON.stringify(appData));
        }

        // Backup
        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(appData, null, 2));
            const a = document.createElement('a');
            a.href = dataStr;
            a.download = "alanwar_backup.json";
            a.click();
        }

        function importData(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (imported.settings && imported.products) {
                        appData = imported;
                        saveToStorage();
                        loadAdminData();
                        alert("تم استيراد البيانات بنجاح! سيتم تحديث الموقع عند الإغلاق.");
                    } else {
                        alert("ملف غير صالح.");
                    }
                } catch (err) {
                    alert("خطأ في قراءة الملف.");
                }
            };
            reader.readAsText(file);
        }

        function resetData() {
            if (confirm("سيتم مسح جميع التعديلات واستعادة البيانات الافتراضية. هل أنت متأكد؟")) {
                localStorage.removeItem('alanwar_v3');
                appData = JSON.parse(JSON.stringify(DEFAULT_CONFIG));
                saveToStorage();
                loadAdminData();
                alert("تم استعادة الإعدادات الافتراضية.");
            }
        }
    </script>
